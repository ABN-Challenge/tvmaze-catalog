{
  "name": "tvmaze-catalog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "imports": {
    "#*": ["./*", "./*.ts", "./*.tsx"]
  },
  "scripts": {
    "dev": "vite --port 5002 --strictPort",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --port 5002 --strictPort",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:watch": "vitest",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx --max-warnings 0",
    "format": "prettier --write .",
    "storybook": "STORYBOOK=true storybook dev -p 6007",
    "build-storybook": "STORYBOOK=true storybook build"
  },
  "dependencies": {
    "pinia": "2.3.1",
    "vue": "3.5.13",
    "vue-router": "4.5.0"
  },
  "devDependencies": {
    "@module-federation/vite": "1.2.7",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/vue3": "10.6.0",
    "@storybook/vue3-vite": "10.6.0",
    "@tailwindcss/vite": "4.0.14",
    "@types/node": "22.13.10",
    "@vitejs/plugin-vue": "5.2.1",
    "@vitest/browser": "3.0.8",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.5.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.22.0",
    "eslint-plugin-vue": "10.0.0",
    "jsdom": "26.0.0",
    "playwright": "1.51.0",
    "prettier": "3.5.3",
    "storybook": "10.6.0",
    "tailwindcss": "4.0.14",
    "typescript": "5.6.3",
    "vite": "5.4.14",
    "vitest": "3.0.8",
    "vue-tsc": "2.2.8"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.2.4"
  }
}
